[Unit]
Description=Kalshi Weather Bot — Streamlit dashboard (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__BOT_USER__
Group=__BOT_USER__
WorkingDirectory=__INSTALL_DIR__
Environment=KALSHI_WEATHER_ROOT=__INSTALL_DIR__
# KALSHI_WEATHER_PYTHON tells subprocess calls (kalshi_account_snapshot.py)
# which Python to use. Without this, dashboard.py falls back to
# /usr/bin/python3 which on Ubuntu 22.04 has cryptography 3.4.8 — too old
# for the padding.PSS.DIGEST_LENGTH attribute the Kalshi signer uses.
Environment=KALSHI_WEATHER_PYTHON=__INSTALL_DIR__/venv/bin/python3
Environment=PYTHONPATH=__INSTALL_DIR__/src
Environment=PYTHONUNBUFFERED=1
# Pass Kalshi creds through to the snapshot subprocess the dashboard
# invokes (scripts/kalshi_account_snapshot.py). Without these the
# subprocess falls back to ``~/.kalshi/private_key.pem`` under the
# kalshibot home dir (which doesn't exist) and the dashboard's ACCOUNT
# row shows "API: [Errno 2] No such file or directory". Bug found
# 2026-05-19 right after the cutover.
Environment=KALSHI_API_KEY_ID=2d618372-e5bb-4515-a5a5-0e41b4717ad6
Environment=KALSHI_PRIVATE_KEY_PATH=__INSTALL_DIR__/secrets/private_key.pem
# Bind to 0.0.0.0 so we can reach via the public IP + Lightsail firewall
# (port 8501 must be opened separately via the AWS CLI).
ExecStart=__INSTALL_DIR__/venv/bin/streamlit run \
  __INSTALL_DIR__/scripts/dashboard.py \
  --server.address 0.0.0.0 \
  --server.port 8501 \
  --server.headless true \
  --server.fileWatcherType none \
  --browser.gatherUsageStats false
Restart=always
RestartSec=10
StandardOutput=append:__INSTALL_DIR__/logs/systemd_dashboard.log
StandardError=append:__INSTALL_DIR__/logs/systemd_dashboard.log

[Install]
WantedBy=multi-user.target
