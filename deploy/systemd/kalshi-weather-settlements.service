[Unit]
Description=Kalshi Weather Bot — morning settlement ingest + survey
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__BOT_USER__
Group=__BOT_USER__
WorkingDirectory=__INSTALL_DIR__
Environment=KALSHI_WEATHER_ROOT=__INSTALL_DIR__
Environment=KALSHI_WEATHER_PYTHON=__INSTALL_DIR__/venv/bin/python3
Environment=PYTHONPATH=__INSTALL_DIR__/src
Environment=PYTHONUNBUFFERED=1
Environment=KALSHI_API_KEY_ID=2d618372-e5bb-4515-a5a5-0e41b4717ad6
Environment=KALSHI_PRIVATE_KEY_PATH=__INSTALL_DIR__/secrets/private_key.pem
Environment=LIVE_ORDERS_ENABLED=0
Environment=LIVE_ORDERS_DRY_RUN=1
ExecStart=/usr/bin/env bash __INSTALL_DIR__/scripts/run_settlements_morning.sh
TimeoutStartSec=30min
StandardOutput=append:__INSTALL_DIR__/logs/systemd_settlements.log
StandardError=append:__INSTALL_DIR__/logs/systemd_settlements.log

[Install]
WantedBy=multi-user.target
