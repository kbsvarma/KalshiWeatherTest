[Unit]
Description=Kalshi Weather Bot — decision cycle (paper mode by default)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=oneshot
User=__BOT_USER__
Group=__BOT_USER__
WorkingDirectory=__INSTALL_DIR__
Environment=KALSHI_WEATHER_ROOT=__INSTALL_DIR__
Environment=KALSHI_WEATHER_PYTHON=__INSTALL_DIR__/venv/bin/python3
Environment=PYTHONPATH=__INSTALL_DIR__/src
Environment=PYTHONUNBUFFERED=1
# Kalshi credentials — point at SSM-fetched or filesystem secret.
# The bootstrap leaves these as path-only; secrets/private_key.pem must be
# placed at /opt/kalshi-weather/secrets/private_key.pem (mode 0400, owner kalshibot)
# OR overridden via systemctl edit kalshi-weather-cycle.service.
Environment=KALSHI_API_KEY_ID=2d618372-e5bb-4515-a5a5-0e41b4717ad6
Environment=KALSHI_PRIVATE_KEY_PATH=__INSTALL_DIR__/secrets/private_key.pem
# AFD extractor: use the smaller 1B model on cloud (2-vCPU box).
# 3B is slower than the 90s budget, 1B finishes in ~25-60s warm.
# Override per-deploy via systemctl edit if needed.
Environment=OLLAMA_MODEL=llama3.2:1b
Environment=OLLAMA_TIMEOUT_SECONDS=90
# ── PAPER MODE — DO NOT EDIT MANUALLY ──
# Use flip_to_live.sh to toggle. The script writes a systemd drop-in at
# /etc/systemd/system/kalshi-weather-cycle.service.d/live.conf which
# overrides these without modifying this base unit.
Environment=LIVE_ORDERS_ENABLED=0
Environment=LIVE_ORDERS_DRY_RUN=1
Environment=LIVE_DAILY_USD_CAP=20.0
ExecStart=/usr/bin/env bash __INSTALL_DIR__/scripts/run_weather_cycle.sh
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=append:__INSTALL_DIR__/logs/systemd_cycle.log
StandardError=append:__INSTALL_DIR__/logs/systemd_cycle.log

[Install]
WantedBy=multi-user.target
